# Supabase Connection (Recommended for cloud)
SUPABASE_CONNECTION_STRING="postgresql://postgres.yourproject.supabase.co:5432/postgres?sslmode=require"
SUPABASE_VECTOR_TABLE="platform_docs"

# Or use local PostgreSQL (for Codespaces)
POSTGRES_CONNECTION_STRING="postgresql://postgres:postgres@localhost:5432/rag_db"

# LLM Settings
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
