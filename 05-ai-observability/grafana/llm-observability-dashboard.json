{
  "title": "LLM Observability",
  "uid": "llm-observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "panels": [
    {
      "type": "timeseries",
      "title": "LLM Requests / sec",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(llm_requests_total[5m])) by (model, status)",
          "legendFormat": "{{model}} {{status}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Token Throughput",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(llm_tokens_total[5m])) by (model, token_type)",
          "legendFormat": "{{model}} {{token_type}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "LLM Cost (USD/hour)",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "sum(increase(llm_cost_dollars_total[1h])) by (feature)",
          "legendFormat": "{{feature}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "p95 Latency by Phase",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(llm_latency_seconds_bucket[5m])) by (le, model, phase))",
          "legendFormat": "{{model}} {{phase}}"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Evaluation Scores",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 16},
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(llm_evaluation_score_bucket[15m])) by (le, model, metric_name))",
          "legendFormat": "{{model}} {{metric_name}}"
        }
      ]
    }
  ]
}